    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The S.I. unit of magnetic flux is",
      "options": [
        "Tesla",
        "Weber",
        "Henry",
        "Joule"
      ],
      "correct_answer": 1,
      "explanation": "The standard international unit for magnetic flux is the Weber (Wb).",
