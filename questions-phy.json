    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The dimensions of pressure are",
      "options": [
        "ML⁻¹T⁻²",
        "MLT⁻²",
        "ML²T⁻²",
        "ML⁻²T⁻²"
      ],
      "correct_answer": 0,
      "explanation": "Pressure equals Force per unit area (F/A), yielding the dimensional formula ML⁻¹T⁻².",
      "id": "q_1786875522729_f647p",
      "created_at": "2026-08-16T10:18:42.729Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "A body starts from rest and moves with a constant acceleration of 2 m/s². The distance covered in 5 seconds is",
      "options": [
        "10 m",
        "25 m",
        "50 m",
        "100 m"
      ],
      "correct_answer": 1,
      "explanation": "Using the relation s = ut + ½at² with u = 0, a = 2, and t = 5 gives s = 0 + ½(2)(5²) = 25 m.",
      "id": "q_1786875522902_w6uh9",
      "created_at": "2026-08-16T10:18:42.902Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The time taken for a stone dropped from a height of 20 m to reach the ground is (Take g = 10 m/s²)",
      "options": [
        "1 s",
        "2 s",
        "4 s",
        "10 s"
      ],
      "correct_answer": 1,
      "explanation": "From s = ½gt², 20 = ½(10)t², which simplifies to t² = 4, giving t = 2 s.",
      "id": "q_1786875522909_r5asc",
      "created_at": "2026-08-16T10:18:42.909Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The apparent weight of a body immersed in a liquid is less than its real weight because of",
      "options": [
        "Surface tension",
        "Upthrust",
        "Viscosity",
        "Capillarity"
      ],
      "correct_answer": 1,
      "explanation": "The upward buoyant force (upthrust) exerted by the fluid reduces the net measured weight of the immersed body.",
      "id": "q_1786875522923_mk0mp",
      "created_at": "2026-08-16T10:18:42.923Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The efficiency of a machine is always less than 100% because of",
      "options": [
        "Friction and weight of moving parts",
        "High velocity ratio",
        "Large mechanical advantage",
        "Low effort applied"
      ],
      "correct_answer": 0,
      "explanation": "Energy losses due to friction and the weight of machine components ensure that useful work output is always less than total work input.",
      "id": "q_1786875522939_vrasq",
      "created_at": "2026-08-16T10:18:42.939Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The device used to measure relative humidity is the",
      "options": [
        "Hydrometer",
        "Barometer",
        "Hygrometer",
        "Manometer"
      ],
      "correct_answer": 2,
      "explanation": "A hygrometer is specifically designed to measure moisture or humidity levels in the atmosphere.",
