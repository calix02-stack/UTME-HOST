      "created_at": "2026-08-16T10:18:42.971Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "An echo is heard 2 seconds after a sound is shouted towards a cliff. If the speed of sound is 340 m/s, the distance of the cliff is",
      "options": [
        "170 m",
        "340 m",
        "680 m",
        "850 m"
      ],
      "correct_answer": 1,
      "explanation": "Distance d = (speed × time) / 2 = (340 × 2) / 2 = 340 m.",
      "id": "q_1786875522974_eqbk8",
      "created_at": "2026-08-16T10:18:42.974Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The image formed by a convex mirror is always",
      "options": [
        "Real, inverted and magnified",
