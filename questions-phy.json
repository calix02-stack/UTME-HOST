      "created_at": "2026-08-16T10:18:42.965Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The pitch of a sound note depends upon its",
      "options": [
        "Amplitude",
        "Frequency",
        "Wavelength only",
        "Speed"
      ],
      "correct_answer": 1,
      "explanation": "The highness or lowness (pitch) of a sound is directly determined by its frequency.",
