    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The quantity of heat required to change a substance from liquid to gas at its constant boiling point is called",
      "options": [
        "Specific heat capacity",
        "Latent heat of fusion",
        "Latent heat of vaporization",
        "Heat capacity"
      ],
      "correct_answer": 2,
      "explanation": "Latent heat of vaporization is the thermal energy needed to transform a liquid into gas without changing its temperature.",
      "id": "q_1786875522950_zh157",
      "created_at": "2026-08-16T10:18:42.950Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The process by which heat is transferred through a vacuum is",
      "options": [
        "Conduction",
        "Convection",
        "Radiation",
        "Diffusion"
      ],
      "correct_answer": 2,
      "explanation": "Thermal radiation involves electromagnetic waves that do not require any material medium for propagation.",
      "id": "q_1786875522957_d8ifn",
      "created_at": "2026-08-16T10:18:42.957Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "If the temperature of a fixed mass of gas is doubled at constant pressure, its volume will",
      "options": [
        "Remain unchanged",
        "Be halved",
        "Be doubled",
        "Quadruple"
      ],
      "correct_answer": 2,
      "explanation": "Charles's law dictates that volume is directly proportional to absolute temperature under constant pressure.",
      "id": "q_1786875522960_6znq5",
      "created_at": "2026-08-16T10:18:42.960Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "The root-mean-square velocity of gas molecules is directly proportional to",
      "options": [
        "Absolute temperature",
        "Square root of absolute temperature",
        "Pressure",
        "Molar mass"
      ],
      "correct_answer": 1,
      "explanation": "From kinetic theory, v_rms = √(3RT/M), showing direct proportionality to the square root of absolute temperature T.",
      "id": "q_1786875522963_geljc",
      "created_at": "2026-08-16T10:18:42.963Z"
    },
    {
      "subject_id": "phy",
      "subject_name": "Physics",
      "type": "cbt",
      "year": null,
      "text": "Which of the following waves cannot be polarized?",
      "options": [
        "Light waves",
        "X-rays",
        "Sound waves",
        "Radio waves"
      ],
      "correct_answer": 2,
      "explanation": "Sound waves are longitudinal waves, and only transverse waves can undergo polarization.",
